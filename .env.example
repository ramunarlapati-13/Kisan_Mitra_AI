# ==============================================================================
# AI Crop Monitor & Assistant — Template Environment Configuration
# Copy this file to .env and provide your private keys/credentials.
# ==============================================================================

# --- Flask Server Secrets ---
SECRET_KEY=your_strong_random_secret_key_here
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# --- Firebase Realtime Database (RTDB) Configuration ---
FIREBASE_ENABLED=true
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_RTDB_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# --- Confidence Safety Thresholds ---
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.60

# --- Storage & Automation Limits ---
MAX_STORED_IMAGES=500
IMAGE_RETENTION_DAYS=30
SCHEDULER_DEFAULT_MIN=60
SCHEDULER_ENABLED=true
